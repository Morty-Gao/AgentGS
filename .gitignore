# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.ipynb_checkpoints/
.cache/

# Virtual environments and uv cache (keep uv.lock tracked)
.venv/
venv/
env/
ENV/
.uv-cache/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Test coverage and automation environments
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Local environment files and secrets
.env
.env.*
!.env.example
!.env.*.example

# Editor and operating system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Project data and working directories (repository root only)
/data/
/outputs/
/forks/
/tmp/

# Installed external tools and frontend artifacts
/tools/
node_modules/
.vite/

# Pipeline source directory is not a build artifact
!scripts/build/
!scripts/build/**
/scripts/build/**/__pycache__/
/scripts/build/**/*.py[cod]
