# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.ipynb_checkpoints/
.cache/

# Virtual environments and uv cache (keep uv.lock tracked)
.venv/
venv/
env/
ENV/
.uv-cache/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Test coverage and automation environments
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Local environment files and secrets
.env
.env.*
!.env.example
!.env.*.example

# Editor and operating system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Prepared datasets: generated results stay local; retain only required inputs.
/data/*
!/data/geotooleval.jsonl
!/data/gem.jsonl
!/data/hazard.jsonl
!/data/reference/
/data/reference/*
!/data/reference/energy.json
!/data/reference/ocean.json
!/data/reference/geography.json
!/data/geoquestions/
/data/geoquestions/*
!/data/geoquestions/profile.json
!/data/metadata/
/data/metadata/*
!/data/metadata/geotooleval.json
!/data/deep_earth/
/data/deep_earth/*
!/data/deep_earth/cross_event_samples.csv
!/data/deep_earth/event_semucb_samples.csv
!/data/deep_earth/location_model_samples.csv
!/data/deep_earth/location_semucb_samples.csv
!/data/deep_earth/usgs_catalog.csv
!/data/deep_earth/usgs_source.csv
!/data/deep_earth/manifest.json
!/data/geotoolkg/
/data/geotoolkg/*
!/data/geotoolkg/default__vector_store.json
!/data/geotoolkg/docstore.json
!/data/geotoolkg/graph_store.json
!/data/geotoolkg/image__vector_store.json
!/data/geotoolkg/import_manifest.json
!/data/geotoolkg/index_store.json
!/data/biodeeptime/
/data/biodeeptime/*
!/data/biodeeptime/observations.csv
!/data/biodeeptime/series.csv
!/data/biodeeptime/zones.geojson
!/data/ccs/
/data/ccs/*
!/data/ccs/zones.geojson
!/data/ccs/crs_inventory.csv
!/data/ccs/facilities.geojson
!/data/ccs/facilities_webmercator.csv
!/data/ccs/injection_monthly_geo.csv
# Compressed forms of those retained multi-file inputs; prepare commands expand them.
!/data/deep_earth.zip
!/data/geotoolkg.zip
!/data/biodeeptime.zip
!/data/ccs.zip
/data/raw/
/outputs/
/forks/
/tmp/

# Installed external tools and frontend artifacts
/tools/
node_modules/
.vite/

# Pipeline source directory is not a build artifact
!scripts/build/
!scripts/build/**
/scripts/build/**/__pycache__/
/scripts/build/**/*.py[cod]
