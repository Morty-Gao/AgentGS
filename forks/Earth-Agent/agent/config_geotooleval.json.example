{
    "mcpServers": {
        "GeoToolEval": {
            "command": "python",
            "args": [
                "tools/GeoToolEval.py",
                "--temp_dir",
                "tmp/tmp/out"
            ]
        }
    },
    "models": [
        {
            "config_name": "geotooleval",
            "model_type": "openai_chat",
            "model_name": "${LLM_MODEL}",
            "api_key": "${LLM_API_KEY}",
            "client_args": {
                "base_url": "${LLM_BASE_URL}"
            },
            "generate_args": {}
        }
    ]
}
